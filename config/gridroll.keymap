#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/runtime-input-processor.dtsi>
#define BASE 0
#define FN 1
#define MOUSE 2
#define SYSTEM 3
/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        system { if-layers = <FN MOUSE>; then-layer = <SYSTEM>; };
    };
    keymap {
        compatible = "zmk,keymap";
        base {
            display-name = "Base";
            bindings = <
                &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BSPC
                &kp ESC &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RET
                &kp LCTRL &kp LALT &kp LGUI &kp C_MUTE &mo FN &kp SPACE &kp SPACE &mo MOUSE &kp LEFT &kp DOWN &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        fn {
            display-name = "Fn";
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSLH
                &trans &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp DEL &kp HOME &kp PG_DN &kp UP &kp PG_UP &kp END &trans
                &trans &trans &trans &kp C_MUTE &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        mouse {
            display-name = "Mouse";
            bindings = <
                &trans &trans &mmv MOVE_UP &trans &trans &trans &trans &msc SCRL_UP &trans &trans &trans &trans
                &trans &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans &trans &mkp LCLK &mkp MCLK &mkp RCLK &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &msc SCRL_DOWN &trans &trans &trans &trans
                &trans &trans &trans &mkp MCLK &trans &trans &trans &trans &msc SCRL_LEFT &trans &msc SCRL_RIGHT
            >;
            sensor-bindings = <&encoder_scroll>;
        };
        system {
            display-name = "System";
            bindings = <
                &studio_unlock &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &out OUT_USB &out OUT_BLE &out OUT_TOG &trans &trans &bt BT_CLR
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &bootloader &sys_reset &trans &kp C_MUTE &trans &trans &trans &trans &trans &sys_reset &bootloader
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        extra1 { status = "reserved"; display-name = "Extra 1"; };
        extra2 { status = "reserved"; display-name = "Extra 2"; };
        extra3 { status = "reserved"; display-name = "Extra 3"; };
        extra4 { status = "reserved"; display-name = "Extra 4"; };
    };
    behaviors {
        encoder_scroll: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        };
    };
    // Separate, discoverable DYA processors; no automatic layer switching/inertia.
    gridroll_scroll: gridroll_scroll {
        compatible = "zmk,input-processor-runtime";
        processor-label = "scroll";
        type = <INPUT_EV_REL>;
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <60>;
        track-remainders;
        xy-to-scroll-enabled;
        #input-processor-cells = <0>;
    };
};
&trackball_listener {
    input-processors = <&mouse_runtime_input_processor>;
    scroll_layer {
        layers = <MOUSE>;
        input-processors = <&gridroll_scroll>;
    };
};
